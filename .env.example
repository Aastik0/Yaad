# Yaad Environment Configuration Template
# ==========================================
# By default, Yaad runs in local DEMO MODE with realistic fixture data
# and zero external API calls. Copy this file to .env.local for development.
# NEVER commit real keys or secrets into this file.

# Application Mode: "demo" (default) or "live"
NEXT_PUBLIC_APP_MODE=demo

# Meta Model API (Server-side only - NEVER expose in client bundles or Unity)
# Required ONLY when live vision analysis is enabled and explicitly approved.
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# Cost & Safety Controls
# Hard server-side spending ceiling ($5.00 MAX for initial testing phase)
META_MAX_SPEND_USD=5
ENABLE_LIVE_META_API=false
META_REQUESTS_KILL_SWITCH=true

# Backward-compatible fallbacks
META_API_KEY=
META_MODEL_ID=muse-spark-1.3
META_MONTHLY_BUDGET_CAP_USD=5

# Supabase Persistence & Authentication (Phase 10)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
# Server-only key (NEVER expose to browser bundles or public code)
SUPABASE_SERVICE_ROLE_KEY=
