# Yaad Environment Configuration
# ==========================================
# By default, Yaad runs in local DEMO MODE with realistic fixture data
# and zero external API calls.

# Application Mode: "demo" (default) or "live"
NEXT_PUBLIC_APP_MODE=demo

# Meta Model API (Server-side only - NEVER expose in client bundles)
# Required ONLY when live vision analysis is enabled and explicitly approved.
META_API_KEY=
META_API_BASE_URL=https://graph.facebook.com/v21.0
META_MODEL_ID=llama-3.2-11b-vision-instruct

# Cost & Safety Controls
META_MONTHLY_BUDGET_CAP_USD=75
META_MAX_RETRIES=1
META_REQUESTS_KILL_SWITCH=false

# Optional Supabase Persistence (Future phase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

